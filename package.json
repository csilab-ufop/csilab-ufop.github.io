{
  "name": "zyvolab-static",
  "version": "1.0.0",
  "description": "Zyvolab static website",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.js",
    "predev": "node scripts/fetch-publications.js --cached && node scripts/check-content.js",
    "dev": "nodemon server.js",
    "prebuild": "node scripts/fetch-publications.js --cached && node scripts/check-content.js",
    "build": "node scripts/build-static.js",
    "fetch:pubs": "node scripts/fetch-publications.js",
    "validate:pubs": "node scripts/validate-publications.js",
    "check:content": "node scripts/check-content.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.1.1",
    "marked": "^16.4.2",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "yaml": "2.9.1"
  }
}
