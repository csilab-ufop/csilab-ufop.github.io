{%- macro section_head(index, eyebrow, title, sub=none, id=none, align="start", level=2, layout="stack", meta=none, reveal=true) -%}
{%- set idx = index -%}
{%- if index is number -%}{%- set idx = ("0" ~ index) if index < 10 else index -%}{%- endif -%}
{%- set lvl = level if (level >= 2 and level <= 4) else 2 -%}
<div class="section-head section-head--{{ align }}{{ ' section-head--split' if layout == 'split' }}"{% if reveal %} data-reveal{% endif %}>
  {%- if idx or eyebrow %}
  <p class="eyebrow">
    {%- if idx %}<span class="eyebrow__index">{{ idx }}</span>{% if eyebrow %}<span class="eyebrow__sep" aria-hidden="true">—</span>{% endif %}{% endif -%}
    {%- if eyebrow %}<span>{{ eyebrow }}</span>{% endif -%}
  </p>
  {%- endif %}
  <h{{ lvl }} class="section-head__title"{% if id %} id="{{ id }}"{% endif %}>{{ title }}</h{{ lvl }}>
  {%- if sub %}
  <p class="section-head__sub">{{ sub }}</p>
  {%- endif %}
  {%- if meta or meta === 0 %}
  <p class="section-head__meta">{{ meta }}</p>
  {%- endif %}
</div>
{%- endmacro -%}

{%- macro page_header(label, title, sub=none, aside=false) -%}
<header class="page-header{{ ' page-header--aside' if aside }}">
  <div class="page-header__bg" aria-hidden="true">
    <div class="page-header__grid"></div>
    <div class="page-header__glow"></div>
    <div class="page-header__cells"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="page-header__scan"></div>
  </div>
  <div class="container page-header__inner">
    {%- if aside %}
    <div class="page-header__main">
    {%- endif %}
    {%- if label %}
    <p class="eyebrow page-header__label">{{ label }}</p>
    {%- endif %}
    <h1 class="page-header__title">{{ title }}</h1>
    {%- if sub %}
    <p class="page-header__sub">{{ sub }}</p>
    {%- endif %}
    {#- caller() output is a SafeString, truthy even when empty: test its length -#}
    {%- set extra = ((caller("extra") if aside else caller()) | trim) if caller else "" %}
    {%- if extra | length %}
    <div class="page-header__extra">{{ extra | safe }}</div>
    {%- endif %}
    {%- if aside %}
    </div>
    {%- set side = (caller("aside") | trim) if caller else "" %}
    {%- if side | length %}
    <div class="page-header__aside">{{ side | safe }}</div>
    {%- endif %}
    {%- endif %}
  </div>
</header>
{%- endmacro -%}

{%- macro page_toc(items, label, sticky=false) -%}
<nav class="page-toc{{ ' page-toc--sticky' if sticky }}" aria-label="{{ label }}">
  <div class="container">
    <ul class="chip-list chip-list--track page-toc__list" role="list">
      {%- for item in items %}
      <li>{{ chip(item.label, item.href, false, "chip--nowrap", item.count) }}</li>
      {%- endfor %}
    </ul>
  </div>
</nav>
{%- endmacro -%}

{%- macro btn(href, label, variant="primary", icon=none, external=false, aria_label=none) -%}
{%- set ic = icon or ("arrow-up-right" if external else none) -%}
{%- set new_tab = data.ui.common.new_tab if (external and data and data.ui and data.ui.common) else "" -%}
<a class="btn btn--{{ variant }}" href="{{ href }}"{% if external %} target="_blank" rel="noopener"{% endif %}{% if aria_label %} aria-label="{{ aria_label }}{{ (' ' ~ new_tab) if new_tab }}"{% endif %}>
  <span class="btn__label">{{ label }}</span>
  {%- if new_tab and not aria_label %}<span class="sr-only"> {{ new_tab }}</span>{% endif %}
  {%- if ic %}{{ _svg(ic, 18, "btn__icon") }}{% endif %}
</a>
{%- endmacro -%}

{#- The last word and the arrow share a no-wrap tail, so a label that fills its line never leaves
    the arrow alone on the next one. -#}
{%- macro link_arrow(href, label, external=false, icon=none, class="") -%}
{%- set text = (label or "") | string | trim -%}
{%- set cut = text.lastIndexOf(" ") -%}
<a class="link-arrow{{ (' ' ~ class) if class }}" href="{{ href }}"{% if external %} target="_blank" rel="noopener"{% endif %}>
  <span class="link-arrow__text">{% if cut > 0 %}{{ text.slice(0, cut) }} {% endif %}<span class="link-arrow__tail">{{ text.slice(cut + 1) }}{{ _svg(icon or ("arrow-up-right" if external else "arrow-right"), 18) }}</span></span>
  {%- if external and data and data.ui %}<span class="sr-only"> {{ data.ui.common.new_tab }}</span>{% endif %}
</a>
{%- endmacro -%}

{%- macro _count(n) -%}{%- if n or n === 0 %}<span class="chip__count">{{ n }}</span>{% endif -%}{%- endmacro -%}

{%- macro chip(label, href=none, current=false, class="", count=none) -%}
{%- if href -%}
<a class="chip{{ (' ' ~ class) if class }}" href="{{ href }}"{% if current %} aria-current="true"{% endif %}>{{ label }}{{ _count(count) }}</a>
{%- else -%}
<span class="chip{{ (' ' ~ class) if class }}">{{ label }}{{ _count(count) }}</span>
{%- endif -%}
{%- endmacro -%}

{%- macro status_chip(status, label) -%}
<span class="chip chip--status chip--status-{{ status }}"><span class="chip__dot" aria-hidden="true"></span>{{ label }}</span>
{%- endmacro -%}

{#- Monogram: the initials on the ridge tile; the monogram filter turns the full name into the
    ridge origin and spacing, so a person has the same tile on every page. -#}
{%- macro avatar(person, size="md", alt="") -%}
{%- set px = {sm: 40, md: 64, lg: 96, xl: 144}[size] or 64 -%}
{%- if person and person.photo -%}
{%- set src = person.photo if (person.photo.indexOf("http") == 0) else (base_path ~ person.photo) -%}
<span class="avatar avatar--{{ size }}"><img src="{{ src }}" alt="{{ alt }}" width="{{ px }}" height="{{ px }}" loading="lazy" decoding="async"></span>
{%- else -%}
{%- set name = (person.name or person.display_name or person.initials or "") if person else "" -%}
<span class="avatar avatar--{{ size }} avatar--monogram" style="{{ name | monogram }}"{% if alt %} role="img" aria-label="{{ alt }}"{% else %} aria-hidden="true"{% endif %}><span class="avatar__initials" translate="no">{{ (person.initials or (person.name | initials)) if person }}</span></span>
{%- endif -%}
{%- endmacro -%}

{#- The name comes first in the source (heading navigation lands on it); the role shows above it. -#}
{%- macro person_id(person, level="h3") -%}
<div class="person__id">
  <{{ level }} class="person__name" translate="no">{{ person.display_name or person.name }}</{{ level }}>
  {%- if person.role_label %}
  <p class="person__role">{{ person.role_label }}</p>
  {%- endif %}
</div>
{%- endmacro -%}

{%- macro stat(value, suffix="", label="", size="md") -%}
{#- numbers, or numeric strings from front matter ("14"), count up; anything else ("16+") is shown as is -#}
{%- set n = value | int(-1) -%}
{%- set count = value if (value is number) else (n if (n >= 0 and (n | string) == (value | string | trim)) else none) -%}
{%- set shown = (count | num) if (count is number) else value -%}
<div class="stat{{ (' stat--' ~ size) if (size == 'sm' or size == 'xl') }}">
  <p class="stat__value">
    <span class="stat__num"{% if count is number %} data-count-to="{{ count }}"{% endif %} aria-hidden="true">{{ shown }}</span>
    {%- if suffix %}<span class="stat__suffix" aria-hidden="true">{{ suffix }}</span>{% endif -%}
    <span class="sr-only">{{ shown }}{{ suffix }}</span>
  </p>
  {%- if label %}
  <p class="stat__label">{{ label }}</p>
  {%- endif %}
</div>
{%- endmacro -%}
