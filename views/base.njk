{#-
  Base layout. Pages: {% extends "base.njk" %} and fill the blocks
    head        page stylesheet (<link rel="stylesheet" href="{{ base_path }}/css/pages/x.css">), preloads
    jsonld      structured data (<script type="application/ld+json">…</script>), e.g. on the home page
    content     everything inside <main id="main">
    scripts     page scripts (<script type="module" src="{{ base_path }}/js/x.js"></script>)
    head_early  inline scripts that must run before any stylesheet (the 404 legacy redirect)
  SEO title/description come from page.title / page.description (front matter).
-#}
{%- from "_macros.njk" import icon, brand with context -%}
{%- set ui = data.ui or {} -%}
{%- set indexable = currentPage not in ["404", "_styleguide"] -%}
{#- es_LA: the Spanish copy is Latin American (pregrado, postularte, video) -#}
{%- set og_locales = { pt: "pt_BR", en: "en_US", es: "es_LA", it: "it_IT" } -%}
<!DOCTYPE html>
<html lang="{{ lang_html }}" dir="ltr" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>(function(e){e.classList.remove("no-js");e.classList.add("js");setTimeout(function(){if(!e.classList.contains("is-ready")){e.classList.remove("js");e.classList.add("no-js")}},4000)})(document.documentElement)</script>
{%- block head_early %}{% endblock %}
<title>{{ page.title or data.site.name }}</title>
{%- if page.description %}
<meta name="description" content="{{ page.description }}">
{%- endif %}
{%- if indexable %}
<link rel="canonical" href="{{ site_url }}{{ lang_urls[lang] }}">
{%- for code, l in languages %}
<link rel="alternate" hreflang="{{ l.html }}" href="{{ site_url }}{{ lang_urls[code] }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site_url }}{{ lang_urls[default_lang or 'pt'] }}">
{%- else %}
<meta name="robots" content="noindex">
{%- endif %}
<meta name="theme-color" content="#060607">
<meta name="color-scheme" content="dark">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ data.site.name }}">
<meta property="og:title" content="{{ page.title or data.site.name }}">
{%- if page.description %}
<meta property="og:description" content="{{ page.description }}">
{%- endif %}
{%- if indexable %}
<meta property="og:url" content="{{ site_url }}{{ lang_urls[lang] }}">
{%- endif %}
{#- one card per language (the lab name is written in the image): og-card-pt.jpg, og-card-en.jpg … -#}
<meta property="og:image" content="{{ site_url }}{{ base_path }}/images/og-card-{{ lang }}.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ data.site.short_name or data.site.name }} — {{ ui.footer.description }}">
<meta property="og:locale" content="{{ og_locales[lang] or (lang_html | replace('-', '_')) }}">
{#- data-lang: the 404 page swaps the locales client-side for the language of the URL -#}
{%- for code, l in languages %}{% if code != lang %}
<meta property="og:locale:alternate" content="{{ og_locales[code] or (l.html | replace('-', '_')) }}" data-lang="{{ code }}">
{%- endif %}{% endfor %}
<meta name="twitter:card" content="summary_large_image">
{%- if data.site.social and data.site.social.twitter %}
<meta name="twitter:site" content="{{ data.site.social.twitter.handle }}">
{%- endif %}
<link rel="icon" href="{{ base_path }}/favicon.ico" sizes="32x32">
<link rel="icon" href="{{ base_path }}/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ base_path }}/apple-touch-icon.png">
<link rel="preload" href="{{ base_path }}/fonts/83afe278b6a6bb3c.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ base_path }}/fonts/fc566e733948aae3.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ base_path }}/css/site.css">
{%- block head %}{% endblock %}
{%- block jsonld %}{% endblock %}
</head>
<body class="page-{{ currentPage }}" id="top">
<a class="skip-link" href="#main" data-nf="skip_link">{{ ui.skip_link }}</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{% block content %}{% endblock %}
</main>
{% include "partials/footer.njk" %}
<div id="site-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-copied="{{ ui.common.copied }}"></div>
<script type="module" src="{{ base_path }}/js/site.js"></script>
{%- block scripts %}{% endblock %}
</body>
</html>
