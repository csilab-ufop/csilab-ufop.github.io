{#-
  Contact (spec/pages.md "Contact"). Page header, then the static in-page nav (page_toc) and four
  ruled sections. Each section opens on the foundation hairline with registration ticks
  (.section--ruled) and a split section head; its content runs full width below the head.
    #coordenacao  coordinator cards ([data-person]): e-mail (mailto) in a field with a copy
                  button, the primary e-mail button, research areas as chips (who to write to)
    #informacoes  location (+ map link), social profiles, institutional links (+ GitHub)
    #ingresso     ways in (data.contact.join_items); each card links to its next step
    #faq          native details/summary accordion, all closed. The home page's legacy #faq
                  links land here; each item has id="faq-<id>" and opens when it is the target.
  Copy buttons need site.js ([data-copy]): without it they are hidden (contact.css).
  Styles: public/css/pages/contact.css (scoped under .page-contato).
-#}
{% extends "base.njk" %}
{%- from "_macros.njk" import icon, brand, section_head, page_header, page_toc, btn, link_arrow, chip, avatar, person_id with context -%}
{%- set ui = data.ui or {} -%}
{%- set common = ui.common or {} -%}
{%- set site = data.site or {} -%}
{%- set social = site.social or {} -%}
{%- set institutions = site.institutions or {} -%}
{%- set contact = data.contact or {} -%}
{%- set location = contact.location or {} -%}
{%- set coordinators = (data.people.groups.coordinators if (data.people and data.people.groups) else []) or [] -%}
{%- set faq = (data.faq.items if data.faq else []) or [] -%}
{%- set brands = ["twitter", "instagram", "github", "scholar", "lattes", "orcid"] -%}
{#- next step of each way in (join_items keys are fixed ids; a key without an entry gets no link) -#}
{%- set join_links = {
  undergrad_research: { href: "#coordenacao", label: page.join_link_undergrad, icon: "arrow-up" },
  graduate: { href: institutions.PPGCC, label: page.join_link_graduate, external: true },
  industry: { href: urls.pesquisa ~ "#consultorias", label: page.join_link_industry }
} -%}

{%- macro pad(n) -%}{{ ("0" ~ n) if n < 10 else n }}{%- endmacro -%}
{#- "http://www3.decom.ufop.br/decom/inicio/" → "decom.ufop.br" -#}
{%- macro host(url) -%}
{%- set h = ((url | string).split("//")[1] or (url | string)).split("/")[0] -%}
{{ h.replace("www3.", "").replace("www.", "") }}
{%- endmacro -%}
{#- one row of the social / institutional lists: icon tile, name, mono detail, arrow -#}
{%- macro link_row(href, name, meta, glyph, no_translate=true) -%}
<li><a class="ct-link" href="{{ href }}" target="_blank" rel="noopener">
  <span class="ct-link__icon">{{ glyph }}</span>
  <span class="ct-link__text"><span class="ct-link__name"{% if no_translate %} translate="no"{% endif %}>{{ name }}</span>{% if meta %} <span class="ct-link__meta" translate="no">{{ meta }}</span>{% endif %}</span>
  {{- icon("arrow-up-right", 16, "ct-link__arrow") -}}
  <span class="sr-only"> {{ common.new_tab }}</span>
</a></li>
{%- endmacro -%}

{% block head %}
<link rel="stylesheet" href="{{ base_path }}/css/pages/contact.css">
{% endblock %}

{% block content %}
{{ page_header(page.page_label, page.page_title, page.page_sub) }}
{{ page_toc([
  { href: "#coordenacao", label: page.coordinators_label },
  { href: "#informacoes", label: page.info_label },
  { href: "#ingresso", label: page.join_label },
  { href: "#faq", label: page.faq_title }
], page.nav_label) }}

{#- 01 — coordination: right under the header, so its head does not wait for a reveal -#}
<section class="section section--ruled ct-section" id="coordenacao" aria-labelledby="coordenacao-title">
  <div class="container">
    {{ section_head(1, page.coordinators_label, page.coordinators_title, page.coordinators_sub, id="coordenacao-title", layout="split", reveal=false) }}
    <ul class="ct-people" role="list">
      {%- for p in coordinators %}
      <li class="card card--interactive ct-person" data-person>
        <div class="ct-person__head">
          {{ avatar(p, "lg") }}
          {{ person_id(p) }}
        </div>
        {%- if p.email %}
        {%- set at = p.email.indexOf("@") + 1 %}
        <div class="ct-email">
          <a class="ct-email__link" href="mailto:{{ p.email }}">{{ icon("mail", 18) }}<span translate="no">{{ p.email.slice(0, at) }}<wbr>{{ p.email.slice(at) }}</span></a>
          <button class="ct-copy" type="button" data-copy="{{ p.email }}" data-copied="{{ common.copied }}">
            {{- icon("copy", 18) }}{{ icon("check", 18) -}}
            <span class="ct-copy__label"><span data-copy-label>{{ common.copy }}</span><span class="ct-copy__alt" aria-hidden="true">{{ common.copied }}</span></span>
            <span class="sr-only" translate="no"> {{ p.email }}</span>
          </button>
        </div>
        {#- the accessible name uses the plain name: "Enviar E-mail para Gladston Moreira" -#}
        {{ btn("mailto:" ~ p.email, page.email_cta, "primary", "arrow-up-right", aria_label=((page.email_cta_label or page.email_cta) | replace("{name}", p.name))) }}
        {%- endif %}
        {%- if p.tag_items and p.tag_items.length %}
        <div class="ct-person__areas">
          <p class="ct-person__areas-label" id="ct-areas-{{ loop.index }}">{{ page.coordinators_areas }}</p>
          <ul class="chip-list ct-areas" role="list" aria-labelledby="ct-areas-{{ loop.index }}">
            {%- for t in p.tag_items %}
            <li>{{ chip(t.label | replace("-", "‑")) }}</li>
            {%- endfor %}
          </ul>
        </div>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- if page.team_link %}
    <p class="ct-more">{{ link_arrow(urls.equipe, page.team_link) }}</p>
    {%- endif %}
  </div>
</section>

{#- 02 — where to find us -#}
<section class="section section--ruled ct-section" id="informacoes" aria-labelledby="informacoes-title">
  <div class="container">
    {{ section_head(2, page.info_label, page.info_title, none, id="informacoes-title", layout="split") }}
    <div class="ct-info" data-reveal style="--i: 1">
      <div class="ct-info__cell ct-info__cell--location">
        <div class="ct-location">
          <h3 class="ct-info__title">{{ icon("location", 18) }}<span>{{ page.location_label }}</span></h3>
          <address class="ct-address">
            {%- if location.room %}<span class="ct-address__room">{{ location.room }}</span>{% endif -%}
            {%- if location.dept %}<span>{{ location.dept }}</span>{% endif -%}
            {%- if location.univ %}<span>{{ location.univ }}</span>{% endif -%}
          </address>
        </div>
        {%- if site.map_url and page.map_link %}
        {#- map tile: the lab's grid with a pin that pings twice when it scrolls in. The whole tile is
            the link, so the label only looks like a link-arrow (its last word keeps the arrow) -#}
        {%- set ml = page.map_link | string | trim %}
        {%- set mcut = ml.lastIndexOf(" ") %}
        <a class="ct-map" href="{{ site.map_url }}" target="_blank" rel="noopener">
          <span class="ct-map__pin" aria-hidden="true"></span>
          <span class="link-arrow ct-map__label"><span class="link-arrow__text">{% if mcut > 0 %}{{ ml.slice(0, mcut) }} {% endif %}<span class="link-arrow__tail">{{ ml.slice(mcut + 1) }}{{ icon("arrow-up-right", 18) }}</span></span><span class="sr-only"> {{ common.new_tab }}</span></span>
        </a>
        {%- endif %}
      </div>
      <div class="ct-info__cell">
        <h3 class="ct-info__title">{{ icon("message", 18) }}<span>{{ page.social_label }}</span></h3>
        <ul class="ct-links" role="list">
          {%- for key, s in social %}
          {{ link_row(s.url, s.name, s.handle, brand(key, 18) if key in brands else icon("globe", 18)) }}
          {%- endfor %}
        </ul>
      </div>
      <div class="ct-info__cell">
        <h3 class="ct-info__title">{{ icon("link", 18) }}<span>{{ page.links_label }}</span></h3>
        <ul class="ct-links" role="list">
          {%- for name, url in institutions %}
          {%- set official = (name == "UFOP" and ui.footer and ui.footer.official_site) %}
          {{ link_row(url, ui.footer.official_site if official else name, host(url), icon("building", 18), not official) }}
          {%- endfor %}
          {%- if social.github %}
          {{ link_row(social.github.url, social.github.name, host(social.github.url) ~ "/" ~ social.github.handle, brand("github", 18)) }}
          {%- endif %}
        </ul>
      </div>
    </div>
  </div>
</section>

{#- 03 — ways in -#}
<section class="section section--ruled ct-section" id="ingresso" aria-labelledby="ingresso-title">
  <div class="container">
    {{ section_head(3, page.join_label, page.join_title, page.join_sub, id="ingresso-title", layout="split") }}
    <ul class="ct-paths" role="list">
      {%- for key, item in contact.join_items %}
      {%- set link = join_links[key] %}
      {%- set linked = link and link.href and link.label %}
      <li class="card ct-path{{ ' card--interactive' if linked }}" data-reveal style="--i: {{ loop.index }}">
        <span class="tile-icon">{{ icon(item.icon or "sparkles", 22) }}</span>
        <h3 class="card__title">{{ item.title }}</h3>
        <p class="card__text">{{ item.text }}</p>
        {%- if linked %}
        <p class="card__foot ct-path__foot">{{ link_arrow(link.href, link.label, link.external, link.icon, "card__link") }}</p>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- 04 — FAQ -#}
<section class="section section--ruled ct-section" id="faq" aria-labelledby="faq-title">
  <div class="container">
    {{ section_head(4, page.faq_label, page.faq_title, page.faq_sub, id="faq-title", layout="split") }}
    <div class="accordion-group ct-faq">
      {%- for item in faq %}
      <details class="accordion ct-faq__item"{% if item.id %} id="faq-{{ item.id }}"{% endif %} data-reveal style="--i: {{ loop.index }}">
        <summary><span class="ct-faq__num" aria-hidden="true">{{ pad(loop.index) }}</span><span class="ct-faq__q">{{ item.question }}</span><span class="accordion__chevron" aria-hidden="true">{{ icon("chevron-down", 18) }}</span></summary>
        <div class="accordion__body prose">{{ item.answer_html | safe }}</div>
      </details>
      {%- endfor %}
    </div>
    {%- if page.faq_more %}
    <p class="ct-more">{{ link_arrow("#coordenacao", page.faq_more, false, "arrow-up", "ct-up") }}</p>
    {%- endif %}
  </div>
</section>
{% endblock %}

{% block scripts %}
{#- a link to /contato/#faq-<id> opens that question (also on later hash changes) -#}
<script>(function(){function o(){var i=location.hash.slice(1),e;try{i=decodeURIComponent(i)}catch(_){}e=i&&document.getElementById(i);if(e&&e.tagName==="DETAILS")e.open=true}o();addEventListener("hashchange",o)})()</script>
{% endblock %}
