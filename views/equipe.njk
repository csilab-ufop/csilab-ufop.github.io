{#-
  People (spec/pages.md "People"; anchors from spec/ia.md), drawn as the lab's organization tree.
  - Levels, top-down: 01 #coordenadores (the root: two feature cards) → a trunk that splits into
    02 #docentes | 03 #colaboradores → 04 Estudantes, which splits into 04.1 #pos-graduacao
    (itself split into #doutorado | #mestrado) | 04.2 #graduacao → 05 #egressos (two registers).
    Every group is shown; there are no tabs.
  - The DOM is the hierarchy: top-level groups are h2 sections, sub-groups h3 (h4 under
    Pós-graduação), faculty names h3; the member lists are lists. Tab order follows it top-down.
  - Connectors are decoration (aria-hidden spans, borders only, people.css): .org-wire--stem
    (a trunk segment between levels, junction dots at its ends), --arm (half of a split bar plus
    the drop into a branch's head), --tail (a branch's riser down to the bar that merges the
    level back into the trunk). They connect levels and groups, never single people, so the
    ruled member grids wrap freely. Below 768px they give way to a file-tree: a spine with an
    elbow to every group and person (pseudo-elements of .org-group and .org-item).
  - The sticky page_toc links to the six groups (labels: the footer's ui.footer.people_links,
    keyed by the same anchors, so both name a group the same way).
  - Every person has id="{{ p.slug }}" (the research page links to it) and a :target cue.
  Styles: public/css/pages/people.css (scoped under .page-equipe).
-#}
{% extends "base.njk" %}
{%- from "_macros.njk" import icon, brand, section_head, page_header, page_toc, btn, avatar, person_id with context -%}
{%- set ti = data.team_i18n or {} -%}
{%- set gt = ti.groups or {} -%}
{%- set groups = data.people.groups -%}
{%- set ui = data.ui or {} -%}
{%- set nav_labels = (ui.footer.people_links if ui.footer else none) or {} -%}
{%- set new_tab = ui.common.new_tab if ui.common else "" -%}
{%- set n_grad = (groups.phd_students | length) + (groups.masters_students | length) -%}
{%- set n_students = n_grad + (groups.undergrads | length) -%}
{%- set n_alumni = (groups.alumni_grad | length) + (groups.alumni_undergrad | length) -%}

{#- "{name}" / "{n}" placeholders in page keys -#}
{%- macro named(text, name) -%}{{ (text or "") | replace("{name}", name) }}{%- endmacro -%}
{%- macro count_text(n) -%}{{ ((page.count_one if n == 1 else page.count_other) or "{n}") | replace("{n}", n) }}{%- endmacro -%}

{#- Profile links, always with a visible label: the full one on the coordinator cards (the e-mail
    address, "Google Scholar"…), a short one elsewhere ("Lattes", "Scholar"). The accessible
    name names the person by the plain name (no "Prof." prefix, which would need an article in
    pt/es/it) and contains the visible label; external links say they open a new tab. -#}
{%- macro person_links(p, labelled=false) -%}
{%- set name = p.name or p.display_name -%}
{%- if p.email or p.scholar_url or p.lattes_url or p.website %}
<ul class="person__links{{ ' person__links--labelled' if labelled }}" role="list">
  {%- if p.email %}
  <li><a class="plink plink--email" href="mailto:{{ p.email }}" aria-label="{{ (p.email if labelled else page.email_short) }} — {{ named(page.email_label, name) }}">{{ icon("mail", 16) }}<span class="plink__text"{% if labelled %} translate="no"{% endif %}>{{ p.email if labelled else page.email_short }}</span></a></li>
  {%- endif %}
  {%- for l in [
    { url: p.scholar_url, label: page.scholar_label, text: "Google Scholar" if labelled else "Scholar", glyph: "scholar" },
    { url: p.lattes_url, label: page.lattes_label, text: "Lattes", glyph: "lattes" },
    { url: p.website, label: page.website_label, text: page.website_short, glyph: "web" }
  ] %}
  {%- if l.url %}
  <li><a class="plink" href="{{ l.url }}" target="_blank" rel="noopener" aria-label="{{ named(l.label, name) }} {{ new_tab }}">
    {{- icon("web", 16) if l.glyph == "web" else brand(l.glyph, 16) -}}
    <span class="plink__text">{{ l.text }}</span>{{ icon("arrow-up-right", 14, "plink__ext") }}
  </a></li>
  {%- endif %}
  {%- endfor %}
</ul>
{%- endif %}
{%- endmacro -%}

{#- research interests: chips on the coordinator cards, a keyword line in the roster cells.
    In the line, a keyword of up to 20 characters never breaks inside (no-break spaces: it
    fits the narrowest cell, ~190px at 768–959px); a longer one wraps like text. -#}
{%- macro keyword(label) -%}
{%- if (label | length) <= 20 -%}{{ label | escape | replace(" ", "&nbsp;") | safe }}{%- else -%}{{ label }}{%- endif -%}
{%- endmacro -%}
{%- macro person_tags(p, as_chips=false) -%}
{%- if p.tag_items and p.tag_items.length %}
<ul class="{{ 'chip-list person__tags' if as_chips else 'person__kw' }}" role="list" aria-label="{{ page.tags_label }}">
  {%- for t in p.tag_items %}
  <li>{% if as_chips %}<span class="chip">{{ t.label }}</span>{% else %}{{ keyword(t.label) }}{% endif %}</li>
  {%- endfor %}
</ul>
{%- endif %}
{%- endmacro -%}

{#- "Doutorado · desde 2022": lines break after the separator; short parts (up to 12
    characters, e.g. "desde 2022") never break inside -#}
{%- macro since(label) -%}
{%- for part in (label | string).split(" · ") %}{{ (part | escape | replace(" ", "&nbsp;") | safe) if (part | length) <= 12 else part }}{% if not loop.last %}&nbsp;· {% endif %}{% endfor -%}
{%- endmacro -%}

{#- one person = one tree node (li.org-item: the elbow on phones) holding the person's cell
    ([data-person], the id, the row-hover/:target cue) -#}
{%- macro lead_card(p, i) -%}
<li class="org-item">
  <div class="card person person--lead" id="{{ p.slug }}" data-person data-reveal style="--i: {{ i }}">
    <div class="lead__body">
      {{ avatar(p, "xl") }}
      {{ person_id(p) }}
      {{ person_tags(p, true) }}
    </div>
    {%- set links = person_links(p, true) | trim %}
    {%- if links %}
    <div class="lead__foot">{{ links | safe }}</div>
    {%- endif %}
  </div>
</li>
{%- endmacro -%}

{%- macro faculty_cell(p, i) -%}
<li class="org-item">
  <div class="person person--faculty row-hover" id="{{ p.slug }}" data-person data-reveal style="--i: {{ i }}">
    <div class="person__body">
      {{ avatar(p, "md") }}
      {{ person_id(p) }}
      {{ person_tags(p) }}
      {{ person_links(p) }}
    </div>
  </div>
</li>
{%- endmacro -%}

{%- macro student_cell(p, i) -%}
<li class="org-item">
  <div class="person person--student row-hover" id="{{ p.slug }}" data-person data-reveal style="--i: {{ i }}">
    {{ avatar(p, "sm") }}
    <div class="person__id">
      <p class="person__name" translate="no">{{ p.display_name or p.name }}</p>
      {%- if p.since_label %}
      <p class="person__since">{{ since(p.since_label) }}</p>
      {%- endif %}
    </div>
    {{ person_links(p) }}
  </div>
</li>
{%- endmacro -%}

{#- Ruled member grid. Faculty: 2 columns from 960px in a two-column branch, otherwise one per
    row; students: always one per row (the branches are the columns). A hatched cell closes
    an odd last row (people.css, data-fill). -#}
{%- macro roster(items, kind, cols=1) -%}
{%- set n = items | length -%}
{%- if n %}
<ul class="roster roster--{{ kind }}" role="list" data-cols="{{ cols }}" data-fill="{{ (cols - n % cols) % cols }}">
  {%- for p in items %}
  {{ faculty_cell(p, loop.index0 % cols) if kind == "faculty" else student_cell(p, loop.index0 % 3) }}
  {%- endfor %}
</ul>
{%- endif %}
{%- endmacro -%}

{#- a group's node: the pin (where its connector lands), then the section head, centred
    (the head's meta is the headcount) -#}
{%- macro node_head(index, eyebrow, title, sub, n, title_id, level=2, kind="branch") -%}
<div class="org-head org-head--{{ kind }}">
  {{ section_head(index, eyebrow, title, sub, id=title_id, align="center", level=level, meta=count_text(n)) }}
</div>
{%- endmacro -%}

{#- connectors (decoration): the outer span is the box that reveals (data-reveal), the inner one
    draws. stem: top/bottom = which ends get a junction dot; root: the red one -#}
{%- macro stem(top=true, bottom=true, root=false) -%}
<span class="org-wire org-wire--stem" aria-hidden="true" data-reveal><span class="org-wire__line{{ ' has-top' if top }}{{ ' has-bottom' if bottom }}{{ ' is-root' if root }}"></span></span>
{%- endmacro -%}
{%- macro arm() -%}<span class="org-wire org-wire--arm" aria-hidden="true" data-reveal><span class="org-wire__line"></span></span>{%- endmacro -%}
{%- macro tail(joint=false) -%}<span class="org-wire org-wire--tail" aria-hidden="true" data-reveal><span class="org-wire__line{{ ' has-joint' if joint }}"></span></span>{%- endmacro -%}

{% block head %}
<link rel="stylesheet" href="{{ base_path }}/css/pages/people.css">
{% endblock %}

{% block content %}
{{ page_header(page.page_label, page.page_title, page.page_sub) }}
{{ page_toc([
  { href: "#coordenadores", label: nav_labels.coordenadores or gt.coordinators.label, count: groups.coordinators | length },
  { href: "#docentes", label: nav_labels.docentes or gt.professors.label, count: groups.professors | length },
  { href: "#colaboradores", label: nav_labels.colaboradores or gt.collaborators.label, count: groups.collaborators | length },
  { href: "#pos-graduacao", label: page.nav_graduate or nav_labels["pos-graduacao"] or ti.graduate_title, count: n_grad },
  { href: "#graduacao", label: page.nav_undergrad or nav_labels.graduacao or gt.undergrads.label, count: groups.undergrads | length },
  { href: "#egressos", label: nav_labels.egressos or gt.alumni_grad.label, count: n_alumni }
], page.nav_label, true) }}

<div class="org">
  <div class="container org__inner">

    {#- 01 — the root -#}
    <section class="org-group org-root" id="coordenadores" aria-labelledby="coordenadores-title">
      {{ node_head(1, gt.coordinators.label, gt.coordinators.title, gt.coordinators.sub, groups.coordinators | length, "coordenadores-title", 2, "root") }}
      {%- if groups.coordinators | length %}
      <ul class="org-leads" role="list">
        {%- for p in groups.coordinators %}
        {{ lead_card(p, loop.index0 % 2) }}
        {%- endfor %}
      </ul>
      {%- endif %}
    </section>

    {#- 02 | 03 — faculty and collaborators, split from the trunk -#}
    <div class="org-level org-level--faculty">
      {{ stem(true, true, true) }}
      <section class="org-group org-branch org-branch--wide" id="docentes" aria-labelledby="docentes-title">
        {{ arm() }}
        {{ node_head(2, gt.professors.label, gt.professors.title, gt.professors.sub, groups.professors | length, "docentes-title") }}
        {{ roster(groups.professors, "faculty", 2) }}
        {{ tail() }}
      </section>
      <section class="org-group org-branch" id="colaboradores" aria-labelledby="colaboradores-title">
        {{ arm() }}
        {{ node_head(3, gt.collaborators.label, gt.collaborators.title, gt.collaborators.sub, groups.collaborators | length, "colaboradores-title") }}
        {{ roster(groups.collaborators, "faculty") }}
        {{ tail() }}
      </section>
    </div>

    {#- 04 — students: graduate (PhD | master's) and undergraduate research -#}
    <section class="org-group org-tier" aria-labelledby="estudantes-title">
      {{ stem(true, false) }}
      {{ node_head(4, none, ti.students_title, ti.students_sub, n_students, "estudantes-title", 2, "tier") }}
      <div class="org-level org-level--students">
        {{ stem(false, true) }}
        <section class="org-group org-branch org-branch--wide org-branch--parent" id="pos-graduacao" aria-labelledby="pos-graduacao-title">
          {{ arm() }}
          {{ node_head("04.1", gt.phd_students.label, ti.graduate_title, gt.phd_students.sub, n_grad, "pos-graduacao-title", 3, "tier") }}
          <div class="org-level org-level--sub">
            {{ stem(false, true) }}
            {%- for sg in [{ key: "phd_students", id: "doutorado", index: "04.1.1" }, { key: "masters_students", id: "mestrado", index: "04.1.2" }] %}
            <section class="org-group org-branch{{ ' is-last' if loop.last }}" id="{{ sg.id }}" aria-labelledby="{{ sg.id }}-title">
              {{ arm() }}
              {{ node_head(sg.index, none, gt[sg.key].title, none, groups[sg.key] | length, sg.id ~ "-title", 4) }}
              {{ roster(groups[sg.key], "student") }}
              {{ tail() }}
            </section>
            {%- endfor %}
          </div>
          {{ tail(true) }}
        </section>
        <section class="org-group org-branch is-last" id="graduacao" aria-labelledby="graduacao-title">
          {{ arm() }}
          {{ node_head("04.2", gt.undergrads.label, gt.undergrads.title, gt.undergrads.sub, groups.undergrads | length, "graduacao-title", 3) }}
          {{ roster(groups.undergrads, "student") }}
          {{ tail() }}
        </section>
      </div>
    </section>

    {#- 05 — alumni: the last level, two name registers -#}
    <section class="org-group org-tier is-last" id="egressos" aria-labelledby="egressos-title">
      {{ stem(true, false) }}
      {{ node_head(5, gt.alumni_grad.label, ti.alumni_title, ti.alumni_sub, n_alumni, "egressos-title", 2, "tier") }}
      <div class="org-level org-level--alumni">
        {{ stem(false, true) }}
        {%- for key in ["alumni_grad", "alumni_undergrad"] %}
        <section class="org-group org-branch{{ ' org-branch--wide is-last' if loop.last }}" aria-labelledby="{{ key }}-title">
          {{ arm() }}
          <div class="org-head org-head--register" data-reveal>
            <h3 class="org-register__title" id="{{ key }}-title">{{ gt[key].title }}</h3>
            <p class="org-register__count">{{ count_text(groups[key] | length) }}</p>
          </div>
          {%- if groups[key] | length %}
          <ul class="alumni__list" role="list">
            {%- for p in groups[key] %}
            <li class="org-item"><span class="alumni__name" translate="no">{{ p.display_name or p.name }}</span></li>
            {%- endfor %}
          </ul>
          {%- endif %}
        </section>
        {%- endfor %}
      </div>
    </section>

  </div>
</div>

{#- how students start research here (IC, master's, PhD); the contact page's #ingresso has the
    ways in for everyone -#}
<section class="section people-join" aria-labelledby="join-title">
  <div class="container">
    <div class="cta-band" data-reveal>
      <div>
        <h2 class="cta-band__title" id="join-title">{{ page.join_text }}</h2>
        {%- if page.join_sub %}
        <p class="cta-band__text">{{ page.join_sub }}</p>
        {%- endif %}
        <ol class="join-steps" role="list">
          {%- for s in [{ t: page.join_ic_title, x: page.join_ic_text }, { t: page.join_ms_title, x: page.join_ms_text }, { t: page.join_phd_title, x: page.join_phd_text }] %}
          {%- if s.t %}
          <li class="join-steps__item"><span class="join-steps__index" aria-hidden="true">0{{ loop.index }}</span><h3 class="join-steps__title">{{ s.t }}</h3><p class="join-steps__text">{{ s.x }}</p></li>
          {%- endif %}
          {%- endfor %}
        </ol>
      </div>
      {{ btn(urls.contato ~ "#ingresso", page.join_btn, "primary", "arrow-right") }}
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
{#- From 768px, sibling groups sit side by side (Docentes | Colaboradores, Pós-graduação |
    Graduação) and share a top, so the shared scroll-spy (site.js, by section tops) would always
    mark the later one. Within such a row the mark goes to the chip the reader chose last, else
    to the first group of the row. Only aria-current moves; nothing depends on it. -#}
<script type="module">
const list = document.querySelector('.page-toc--sticky ul');
const chips = list ? [...list.querySelectorAll('a[href^="#"]')] : [];
const top = (a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))?.getBoundingClientRect().top;
let chosen = null;
list?.addEventListener('click', (e) => { chosen = e.target.closest('a'); }, true);
const spy = new MutationObserver((records) => {
  const set = records.map((r) => r.target).filter((a) => a.getAttribute('aria-current') === 'true').pop();
  if (!set) return;
  const y = top(set);
  const row = chips.filter((a) => Math.abs(top(a) - y) < 4);
  if (chosen && !row.includes(chosen)) chosen = null;
  const pick = row.length > 1 ? (chosen || row[0]) : set;
  chips.forEach((a) => (a === pick ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  spy.takeRecords(); // our own changes
});
if (chips.length) spy.observe(list, { subtree: true, attributes: true, attributeFilter: ['aria-current'] });
</script>
{% endblock %}
